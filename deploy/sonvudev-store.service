[Unit]
Description=SonVuDev Store Node.js application
# caddy is named so the application does not start before the proxy that terminates
# TLS in front of it, nor restart ahead of it. After, not Requires: whether anything
# sits in front of the shop is the host's decision, and a unit that hard-fails
# because caddy is absent would take down a shop serving perfectly well without it.
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple
User=sonvudev
Group=sonvudev
WorkingDirectory=/opt/sonvudev-store/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/sonvudev-store.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sonvudev-store/shared
StandardOutput=append:/var/log/sonvudev-store.log
StandardError=append:/var/log/sonvudev-store.error.log

[Install]
WantedBy=multi-user.target
