# The environment the systemd unit and deploy.sh read.
#
# deploy.sh copies this file to /etc/sonvudev-store.env and never reads the
# repository's .env, so that a deploy cannot accidentally ship a developer's local
# configuration. Until now the file it demands did not exist anywhere in the
# repository — the first thing a new owner had to do was reverse-engineer the list
# from the service unit and the failing error message.
#
# To set up a machine:
#
#   sudo install -m 640 -o root -g sonvudev deploy/sonvudev-store.env.example \
#        /etc/sonvudev-store.env
#   sudo editor /etc/sonvudev-store.env
#   sudo /opt/sonvudev-store/deploy/deploy.sh
#
# Values that name the shop itself — the brand, the legal entity, the founder, the
# social links — are here and not hardcoded anywhere in the code, because they are
# what appears on a buyer's bank statement, on their PayPal receipt, and in the
# terms they agree to. sync-render.mjs used to leave all five out of the list it
# pushes to Render, so on that host they silently kept their defaults.
#
# Anything still showing its default value here is a setting that has never been
# made. `npm run check:production` says so out loud rather than passing.

# --- Where the shop lives -----------------------------------------------------
# The public origin. Decides the canonical URL, the sitemap, the links in every
# email, and the domain Caddy is configured with.
APP_URL=https://example.com
# Read by the Caddyfile. Not the same variable as APP_URL on purpose: the proxy
# needs the bare host and the app needs the full URL, and one of them changing
# should not silently rewrite the other.
SITE_DOMAIN=example.com

# --- Who the shop is ----------------------------------------------------------
BRAND_NAME=SonVuDev
# What a buyer sees on their bank or PayPal statement. Leave blank only if there is
# genuinely no registered entity, and then say so in the terms.
BRAND_LEGAL_ENTITY=
BRAND_FOUNDER_NAME=
BRAND_FOUNDER_URL=
# Space-separated, as in BRAND_SOCIAL_LINKS=https://github.com/x,https://linkedin.com/in/x
BRAND_SOCIAL_LINKS=

# --- Where buyers write -------------------------------------------------------
SUPPORT_EMAIL=support@example.com
EMAIL_FROM=SonVuDev <no-reply@example.com>

# --- Payments -----------------------------------------------------------------
# Order currency and price. Not a secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal dashboard. Without it the webhook route rejects every
# delivery, and an order paid by card stays pending until something reconciles it.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# live for sandbox, live for real money. Getting this wrong takes real payments
# into a sandbox that will never capture them.
PAYPAL_ENVIRONMENT=live
# Leave blank to read a live rate, or pin it: a rate that moves under a price the
# buyer already agreed to is a conversation nobody wants. The fallback is the rate
# used when the rate provider cannot be reached and nothing is pinned — a sale must
# not fail because a third party is down.
PAYPAL_VND_TO_USD_RATE=
PAYPAL_VND_TO_USD_FALLBACK=
PAYPAL_RATE_TTL_SECONDS=3600
# Added on top of the live rate to cover the provider's spread, so the captured
# amount is never less than the buyer's.
PAYPAL_RATE_MARGIN_PERCENT=3
PAYPAL_ACCOUNT_EMAIL=

# --- Bank transfer ------------------------------------------------------------
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BIN=970436
BANK_TRANSFER_NOTE_PREFIX=SonVuDev
MOMO_ACCOUNT_NUMBER=
MOMO_QR_IMAGE=
MOMO_QR_AMOUNT_IMAGE=
MOMO_DEEP_LINK=
ZALOPAY_ACCOUNT_NUMBER=
ZALOPAY_QR_IMAGE=

# --- Storage and database -----------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# How long a signed upload URL and a signed download URL live. Short on purpose:
# the download URL is the only thing standing between a leaked link and a free
# copy, and it is handed to a browser that may sit on it for a day.
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=300

# --- Access -------------------------------------------------------------------
# The one token that opens /admin. It has no expiry and no second factor, so it is
# the credential to rotate first and to keep out of shell history.
ADMIN_API_TOKEN=

# --- Transactional mail -------------------------------------------------------
# Without this the four order emails are written to data/outbox instead, and no
# buyer receives an order confirmation or a download link.
RESEND_API_KEY=

# --- Orders and search --------------------------------------------------------
# How long an unpaid order survives before it is cancelled. Quoted to the buyer on
# the checkout form and in the terms, so it is one number read from here.
ORDER_PAYMENT_WINDOW_HOURS=24
ORDER_EXPIRY_WARN_HOURS=1
ORDER_SWEEP_INTERVAL_MS=60000
# Bing and Google. Missing is fine; present and wrong is worse than absent.
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Rate limiting and geo ----------------------------------------------------
# Behind Caddy, so the client address is the last hop's X-Forwarded-For. Leave this
# on for any host that forwards; turn it off only when nothing does, because
# getting it wrong makes every visitor share one address and one rate-limit budget.
TRUST_PROXY=1
# Whether a visitor's country is looked up to decide which payment rails to lead
# with. The lookup is a network call to a third party that sees the client's
# address, so it is a switch rather than a default.
GEOIP_ENABLED=1
GEO_LOOKUP=
GEO_CACHE_HOURS=24
HOST=127.0.0.1
PORT=3000
