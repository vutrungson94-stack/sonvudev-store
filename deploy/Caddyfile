# The shop's own host comes from the environment, not from a line written here.
#
# This file pinned the reverse proxy to one domain, so moving the shop to another
# host meant the proxy kept serving the old name and nothing said so. Caddy reads
# this value at load, so it is set where the service is started:
#
#   SITE_DOMAIN=example.com caddy run --config /etc/caddy/Caddyfile
#
# and deploy.sh loads this file into place and reloads the service with SITE_DOMAIN
# and PORT taken from /etc/sonvudev-store.env — the same file every other value comes
# from. Until it did, this configuration shipped in every artifact and reached no host
# at all: deploy.sh copied the systemd unit and nothing else, so Caddy kept serving
# whatever it was configured with on the day it was first set up, and an edit here was
# invisible until someone reconfigured Caddy by hand. Two domains are served because
# the app 308s www to the bare host; that redirect is the app's job, not the proxy's.
#
# A missing SITE_DOMAIN is a load error rather than a default, deliberately: a proxy
# that came up answering for no host looks healthy and serves nothing.
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
  encode zstd gzip
  # The port comes from the environment for the same reason the domain does. It
  # was pinned to 3000 here while PORT was a documented, configurable variable,
  # so changing the port left the proxy and the post-deploy health check talking
  # to nothing and the shop simply stopped answering.
  reverse_proxy 127.0.0.1:{$PORT:3000}

  header {
    -Server
  }

  log {
    output file /var/log/caddy/sonvudev-access.log
    format json
  }
}
