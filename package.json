{
  "name": "sonvudev-store",
  "version": "1.0.0",
  "description": "SonVuDev software storefront with private R2 downloads and PayPal checkout",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "css:minify": "node scripts/minify-css.mjs",
    "check:production": "node scripts/production-check.mjs",
    "check:publish-output": "node scripts/check-publish-output.mjs",
    "paypal:setup": "node scripts/setup-paypal.mjs",
    "paypal:detect": "node scripts/setup-paypal.mjs --detect",
    "db:check": "node scripts/db-migrate.mjs --check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:apply": "node scripts/db-migrate.mjs --apply",
    "email:check": "node scripts/mail-check.mjs",
    "product:publish": "node scripts/publish-product.mjs",
    "r2:cors": "node scripts/r2-cors.mjs",
    "r2:cors:write": "node scripts/r2-cors.mjs --write",
    "r2:cors:command": "node scripts/r2-cors.mjs --command",
    "render:sync": "node scripts/sync-render.mjs",
    "render:sync:apply": "node scripts/sync-render.mjs --apply",
    "render:sync:deploy": "node scripts/sync-render.mjs --apply --deploy",
    "render:deploy": "node scripts/sync-render.mjs --deploy",
    "lint": "node scripts/lint-web.mjs",
    "audit": "node scripts/audit-web.mjs",
    "case": "node scripts/case-check.mjs",
    "coverage": "node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=70",
    "workflow": "node scripts/check-workflows.mjs",
    "metrics": "node scripts/metrics.mjs",
    "metrics:update": "node scripts/metrics.mjs --update",
    "metrics:auto": "node scripts/metrics.mjs --auto-update",
    "metrics:trends": "node scripts/metrics.mjs --trends",
    "dora:metrics": "node scripts/dora-metrics.mjs",
    "dora:check": "node scripts/dora-metrics.mjs --check",
    "quality:report": "node scripts/quality-report.mjs",
    "slo:check": "node scripts/slo-monitor.mjs",
    "spc:check": "node scripts/spc-control-chart.mjs",
    "defect:escape": "node scripts/defect-escape.mjs",
    "defect:check": "node scripts/defect-escape.mjs",
    "postmortem:check": "node scripts/incident-postmortem.mjs check",
    "postmortem:new": "node scripts/incident-postmortem.mjs new",
    "postmortem:resolve": "node scripts/incident-postmortem.mjs resolve",
    "sla:check": "node scripts/sla-monitor.mjs",
    "catalog:check": "node scripts/service-catalog.mjs",
    "golden:check": "node scripts/golden-path.mjs",
    "asset:library": "node scripts/asset-library.mjs",
    "i18n:fill": "node scripts/fill-static-text.mjs",
    "i18n:products": "node scripts/i18n-products.mjs",
    "translate-locale": "node scripts/translate-locale.mjs",
    "test:flow": "node scripts/payment-flow-test.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "lighthouse:check": "node scripts/lighthouse-check.mjs",
    "assets:logo": "node scripts/make-logo-assets.mjs",
    "assets:og": "node scripts/make-og-image.mjs",
    "assets:products": "node scripts/make-product-images.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/run-tests.mjs",
    "health:check": "node scripts/health-check.mjs",
    "logs:prune": "node scripts/prune-logs.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "rotate:admin-token": "node scripts/rotate-admin-token.mjs",
    "rotate:admin-token:apply": "node scripts/rotate-admin-token.mjs --apply",
    "provenance": "node scripts/provenance.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "trust:virustotal": "node scripts/set-virus-scan.mjs",
    "merchant:feed": "node scripts/generate-merchant-feed.mjs",
    "ops:run": "node scripts/ops-run.mjs",
    "ops:run:apply": "node scripts/ops-run.mjs --apply",
    "ops:catalog": "node scripts/sync-products-to-supabase.mjs",
    "ops:catalog:apply": "node scripts/sync-products-to-supabase.mjs --apply",
    "ops:seo": "node scripts/update-seo.mjs",
    "ops:seo:apply": "node scripts/update-seo.mjs --apply",
    "ops:indexnow": "node scripts/ping-indexnow.mjs",
    "ops:bing": "node scripts/submit-bing-sitemap.mjs",
    "blog:translate": "node scripts/translate-blog.mjs",
    "blog:translate:apply": "node scripts/translate-blog.mjs --apply",
    "translate:smoke": "node scripts/translate-smoke.mjs"
  },
  "files": [
    "src",
    "public",
    "scripts",
    "supabase",
    "cloudflare",
    "deploy",
    "render.yaml",
    "Dockerfile",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "esbuild": "^0.28.2",
    "pureimage": "^0.4.20"
  }
}
