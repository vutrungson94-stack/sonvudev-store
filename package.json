{
  "name": "sonvudev-store",
  "version": "1.0.0",
  "description": "SonVuDev software storefront with private R2 downloads and PayPal checkout",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "check:production": "node scripts/production-check.mjs",
    "check:publish-output": "node scripts/check-publish-output.mjs",
    "paypal:setup": "node scripts/setup-paypal.mjs",
    "paypal:detect": "node scripts/setup-paypal.mjs --detect",
    "db:check": "node scripts/db-migrate.mjs --check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:apply": "node scripts/db-migrate.mjs --apply",
    "email:check": "node scripts/mail-check.mjs",
    "product:publish": "node scripts/publish-product.mjs",
    "r2:cors": "node scripts/r2-cors.mjs",
    "r2:cors:write": "node scripts/r2-cors.mjs --write",
    "r2:cors:command": "node scripts/r2-cors.mjs --command",
    "render:sync": "node scripts/sync-render.mjs",
    "render:sync:apply": "node scripts/sync-render.mjs --apply",
    "render:sync:deploy": "node scripts/sync-render.mjs --apply --deploy",
    "render:deploy": "node scripts/sync-render.mjs --deploy",
    "lint": "node scripts/lint-web.mjs",
    "audit": "node scripts/audit-web.mjs",
    "case": "node scripts/case-check.mjs",
    "workflow": "node scripts/check-workflows.mjs",
    "metrics": "node scripts/metrics.mjs",
    "metrics:update": "node scripts/metrics.mjs --update",
    "metrics:auto": "node scripts/metrics.mjs --auto-update",
    "metrics:trends": "node scripts/metrics.mjs --trends",
    "i18n:fill": "node scripts/fill-static-text.mjs",
    "i18n:products": "node scripts/i18n-products.mjs",
    "test:flow": "node scripts/payment-flow-test.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "assets:logo": "node scripts/make-logo-assets.mjs",
    "assets:og": "node scripts/make-og-image.mjs",
    "assets:products": "node scripts/make-product-images.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/run-tests.mjs",
    "health:check": "node scripts/health-check.mjs",
    "logs:prune": "node scripts/prune-logs.mjs",
    "backup": "node scripts/backup.mjs",
    "provenance": "node scripts/provenance.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "trust:virustotal": "node scripts/set-virus-scan.mjs",
    "merchant:feed": "node scripts/generate-merchant-feed.mjs"
  },
  "files": [
    "src",
    "public",
    "scripts",
    "supabase",
    "cloudflare",
    "deploy",
    "render.yaml",
    "Dockerfile",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "pureimage": "^0.4.20"
  }
}
