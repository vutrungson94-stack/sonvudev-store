# Dependencies
node_modules/
node_modules_stale_*/

# Secrets and local environment
.env
.env.*
!.env.example

# Build/cache
.gbuildcache/
build-reports/
publish-output/
.gbuild-state.gbuildstate
--help/

# Local runtime scratch
logs/
data/
backup/
.tmp-*

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# wrangler's scratch directory: a temp copy of the Worker per deploy, plus
# its source map. Not source, and committing it means the repo contains a second
# copy of the Worker that can drift from the one that runs.
.wrangler/

# Command output pasted at the repo root by hand. The build writes its real
# reports to build-reports/ (ignored) and tests to logs/ (ignored); a loose
# *-results.txt at the root is a stale copy nobody reads.
*-results.txt
