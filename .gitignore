# Dependencies
node_modules/
node_modules_stale_*/

# Secrets and local environment
.env
.env.*
!.env.example

# Build/cache
.gbuildcache/
build-reports/
publish-output/
.gbuild-state.gbuildstate
# The build tool takes a lock beside its state file. Left out of the first
# pattern it shows up as a new untracked file after every build, and an
# untracked file nobody ignores is one commit away from being committed.
.gbuild-state.gbuildstate.lock
--help/

# Generated at build time from build-reports/ and served from public/. Committing
# it would freeze a claim about the current build into a file that only talks
# about the build it was committed with.
public/build-report.json

# Local runtime scratch
logs/
data/
backup/
.tmp-*

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# wrangler's scratch directory: a temp copy of the Worker per deploy, plus
# its source map. Not source, and committing it means the repo contains a second
# copy of the Worker that can drift from the one that runs.
.wrangler/

# Command output pasted at the repo root by hand. The build writes its real
# reports to build-reports/ (ignored) and tests to logs/ (ignored); a loose
# *-results.txt at the root is a stale copy nobody reads.
*-results.txt

# Auto-added by gtest (project gitignore patterns)
_Build/
_Sync/
_Tests/
bin/
obj/
TestResults/
*.log
*.tmp

# --- added by gsync security gate ---
# === SECURITY ===
ssh_id
*.pfx
.vs/
*.apk
*.aab
