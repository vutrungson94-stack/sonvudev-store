# App
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Cloudflare R2 (private bucket; do not set a public base URL for paid files)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_private_bucket_name
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=600

# Optional Supabase persistence. Leave empty to use data/*.json for local development.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Only needed for `npm run db:migrate`, and only on your machine. It is a personal
# access token from https://supabase.com/dashboard/account/tokens and can run DDL.
# Never deploy it to Render: the service role key is enough for everything the
# server itself does.
SUPABASE_ACCESS_TOKEN=

# Order lifetime. An unpaid order is cancelled automatically once this window
# passes, which is the number the checkout form shows, the terms promise and the
# order emails quote. Nothing here is written into a template: change it and the
# wording changes with it.
ORDER_PAYMENT_WINDOW_HOURS=24
# How long before the deadline the "about to expire" email goes out.
ORDER_EXPIRY_WARN_HOURS=1
# How often the server looks for orders to expire.
ORDER_SWEEP_INTERVAL_MS=60000

# Order email. Resend is a plain REST API (no SMTP server, no dependency) and
# its free tier covers this volume. Without a key nothing breaks: every message
# is written to data/outbox instead so the flow can be tested offline.
RESEND_API_KEY=
EMAIL_FROM=SonVuDev <no-reply@sonvudev.com>
SUPPORT_EMAIL=hello@sonvudev.com

# Optional visitor country lookup, used only to order the payment methods and
# explain them. Nothing is ever hidden: a buyer in Vietnam can still choose
# PayPal, and a buyer abroad can still choose a bank transfer. Set to "off" to
# disable the lookup and always use the domestic-first order.
GEO_LOOKUP=auto
GEO_CACHE_HOURS=24

# Search engine ownership. All optional, all independent, and a store that sets
# none of them still works exactly the same — it is simply not registered with
# anyone. See the "Search Console" section of README.md.
#
# Google Search Console issues one string, and it works as a meta tag in the
# homepage or as a file at the site root. The same value below serves both:
#   /google<GOOGLE_SITE_VERIFICATION>.html
#   <meta name="google-site-verification" content="...">
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools issues one string, and it works as a meta tag in the
# homepage. Bing's documented file method is BingSiteAuth.xml, whose exact
# content Bing generates per site, so it is not something to guess at here; the
# meta tag is the reliable one and this server serves it.
# Find the token by selecting the site in the top-left list, then Verification code.
BING_SITE_VERIFICATION=
# IndexNow key. Also the proof of ownership, served at /<INDEXNOW_KEY>.txt. When
# set, saving a product in the admin panel pings Bing, Yandex and Naver straight
# away instead of waiting for the next crawl. Google does not support IndexNow,
# so this complements the sitemap rather than replacing it.
# 8-128 characters, letters, digits and dashes. Any key works: b64.standard.b64encode(uuid.uuid4().bytes)
INDEXNOW_KEY=

# PayPal Orders v2. PayPal does not support VND; VND prices are converted to USD.
# Create the app at https://developer.paypal.com/dashboard/applications (sandbox first).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD
# "live" fetches VND/USD at checkout time. A number pins a fixed rate.
PAYPAL_VND_TO_USD_RATE=live
# Used only if both rate providers are unreachable.
PAYPAL_VND_TO_USD_FALLBACK=26000
# How long a live rate is cached, in seconds.
PAYPAL_RATE_TTL_SECONDS=3600
# Optional markup on the live rate, in percent, to cover PayPal's VND spread.
PAYPAL_RATE_MARGIN_PERCENT=0
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# Only shown to the buyer as contact info when PayPal is configured.
PAYPAL_ACCOUNT_EMAIL=your_paypal_email@example.com

# Bank transfer instructions shown after checkout
BANK_NAME=Example Bank
BANK_ACCOUNT_NAME=SonVuDev
BANK_ACCOUNT_NUMBER=0000000000
# Bank BIN used to build the VietQR image (Vietcombank = 970436).
BANK_BIN=970436
BANK_TRANSFER_NOTE_PREFIX=SonVuDev

# Optional wallets shown as alternatives next to the bank transfer QR code.
MOMO_ACCOUNT_NUMBER=
# QR images live in public/img. Save the file there and point the variable at it.
#   MOMO_QR_IMAGE=/img/momo-qr.png          static "receive money" QR, no amount
#   MOMO_QR_AMOUNT_IMAGE=/img/momo-qr-amount.png   QR that can pre-fill the amount
MOMO_QR_IMAGE=
MOMO_QR_AMOUNT_IMAGE=
MOMO_DEEP_LINK=
ZALOPAY_ACCOUNT_NUMBER=
ZALOPAY_QR_IMAGE=

# Render deploy. Used by `npm run render:sync` to push env vars to production.
# Create a key at https://dashboard.render.com/ > Account Settings > API Keys.
# This token grants access to your whole Render account: keep it in .env only.
RENDER_API_KEY=
# Service name or id. Defaults to "sonvudev".
RENDER_SERVICE=sonvudev
# Optional: set to the service id to skip the name lookup.
RENDER_SERVICE_ID=
